# === dslrBooth local ===
DSLRBOOTH_PASSWORD=your-dslrbooth-password
DSLRBOOTH_API_PORT=1500

# Trigger server port (máy local, dslrBooth gọi callback về đây)
TRIGGER_SERVER_PORT=3001

# === Extension Service (server/cloud) ===
# URL public của Extension Service — Agent dùng để connect WS từ máy Windows
EXTENSION_SERVICE_WS_URL=ws://203.0.113.10:3002/agent

# Token trùng với AGENT_WS_TOKEN bên Extension Service
EXTENSION_SERVICE_WS_TOKEN=change-me-to-a-secure-token

# Logging
LOG_LEVEL=info

# Tự hiện Edge kiosk khi có khách tiếp theo và tự ẩn trước khi mở dslrBooth
AUTO_OPEN_DISPLAY=true
