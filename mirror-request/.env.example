PORT=3000
DB_POLL_INTERVAL_MS=5000
BOOTH_TIMEOUT_MS=300000
AGENT_HEARTBEAT_MS=30000
IP_WHITELIST=127.0.0.1,::1
BACKEND_DB_URL=postgres://user:pass@localhost:5432/backend
AGENT_WS_TOKEN=your-secret-token-here
NOTIFY_WEBHOOK_URL=https://your-web-app.example/webhooks/photo-upload
# Countdown hiển thị tên khách trước khi bắt đầu chụp (5000-10000ms)
NEXT_GUEST_COUNTDOWN_MS=7000

# Phase 1: registration webhook security (D-09/D-10/D-11) and dedup (D-01)
# WEBHOOK_HMAC_SECRET and PROXY_IP_WHITELIST (with real reverse-proxy IPs, not
# just 127.0.0.1) are both mandatory when NODE_ENV=production.
WEBHOOK_HMAC_SECRET=
WEBHOOK_TIMESTAMP_SKEW_MS=300000
REGISTRATION_DEDUP_WINDOW_MS=300000
PROXY_IP_WHITELIST=127.0.0.1

# ─── Added 2026-08-11 ────────────────────────────────────────────────
# These four were missing from this file: the sandbox denies agents all
# access to .env* paths, so five phases of config changes never landed
# here. A `diff` of key names between .env and .env.example therefore
# came back empty for the wrong reason — both were equally out of date.

# Phase 4 (NOT-01). Unset = notifications warn once and are SKIPPED, so
# no photo ever reaches the slideshow. JSON body, 5 keys. See §8.
NOTIFY_WEBHOOK_URL=http://localhost:3001/webhook/json

# The three below are REQUIRED when NODE_ENV=production; the service
# refuses to start without them (src/config.ts:65-75).
WEBHOOK_HMAC_SECRET=
# Note: the literal value 127.0.0.1 is rejected in production on purpose.
PROXY_IP_WHITELIST=
# Empty = every address allowed. That is a deliberate dev escape hatch
# (D-09); it must be set to the real display machines before going live.
DISPLAY_IP_WHITELIST=

# Phase 6 (ingestion cutover, D-09/D-10). All four have site-independent
# defaults and no production fail-fast — see OPS-RUNBOOK.md §3/§10.
VIEW_PROBE_INTERVAL_MS=60000
STATUS_RATE_LIMIT_WINDOW_MS=60000
STATUS_RATE_LIMIT_MAX=30
STATUS_RATE_LIMIT_MAX_KEYS=10000

# Phase 8 — CMS console (D-13/D-14).
#
# CMS_IP_WHITELIST is a SEPARATE list from DISPLAY_IP_WHITELIST above and must
# not be set to the same value. DISPLAY_IP_WHITELIST holds the room's TVs;
# this holds the operator's laptop. Copying one into the other either locks
# the operator out or exposes the CMS to every address that can reach a TV.
# Empty = every address allowed (the same dev escape hatch DISPLAY_IP_WHITELIST
# uses); REQUIRED when NODE_ENV=production — the service refuses to start
# without it.
CMS_IP_WHITELIST=

# The single operator account (D-14). Both are REQUIRED in every environment.
#
# CMS_PASSWORD_HASH is a salted scrypt digest in `salt:hash` hex form, NEVER a
# plaintext password. Mint it offline, on the operator's own machine:
#
#     npm run cms:hash-password -- 'the-password-you-chose'
#
# then paste the printed value here. The service never receives, prints, or
# logs the plaintext. Running the helper twice on the same password prints
# different output — that is the fresh salt, not an error.
CMS_USERNAME=replace-with-cms-username
CMS_PASSWORD_HASH=replace-with-cms-password-hash

# Name of the session cookie. Has a working default; override only if it
# collides with something else served from the same host.
CMS_SESSION_COOKIE_NAME=cms_session

# Uploaded branding assets (D-15). Both have working, site-independent
# defaults and neither is checked at startup, so a production deploy that
# leaves both unset is correct — they are here to be found, not to be set.
#
# CMS_UPLOAD_DIR must stay OUTSIDE the code directory: a written file must
# never land somewhere the process could later execute or serve as source.
# The service creates the directory if it is missing.
CMS_UPLOAD_DIR=./data/uploads
# The cap on ONE decoded image, in bytes. Default 5242880 (5 MiB). Raising it
# also raises the JSON body limit on POST /cms/api/assets, which is derived
# from this value (~4/3 for base64 plus envelope) — see OPS-RUNBOOK.md §12.
CMS_UPLOAD_MAX_BYTES=5242880
