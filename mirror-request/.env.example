PORT=3000
DB_POLL_INTERVAL_MS=5000
BOOTH_TIMEOUT_MS=300000
AGENT_HEARTBEAT_MS=30000
IP_WHITELIST=127.0.0.1,::1
BACKEND_DB_URL=postgres://user:pass@localhost:5432/backend
AGENT_WS_TOKEN=your-secret-token-here
NOTIFY_WEBHOOK_URL=https://your-web-app.example/webhooks/photo-upload
# Countdown hiển thị tên khách trước khi bắt đầu chụp (5000-10000ms)
NEXT_GUEST_COUNTDOWN_MS=7000

# Phase 1: registration webhook security (D-09/D-10/D-11) and dedup (D-01)
# WEBHOOK_HMAC_SECRET and PROXY_IP_WHITELIST (with real reverse-proxy IPs, not
# just 127.0.0.1) are both mandatory when NODE_ENV=production.
WEBHOOK_HMAC_SECRET=
WEBHOOK_TIMESTAMP_SKEW_MS=300000
REGISTRATION_DEDUP_WINDOW_MS=300000
PROXY_IP_WHITELIST=127.0.0.1

# ─── Added 2026-08-11 ────────────────────────────────────────────────
# These four were missing from this file: the sandbox denies agents all
# access to .env* paths, so five phases of config changes never landed
# here. A `diff` of key names between .env and .env.example therefore
# came back empty for the wrong reason — both were equally out of date.

# Phase 4 (NOT-01). Unset = notifications warn once and are SKIPPED, so
# no photo ever reaches the slideshow. JSON body, 5 keys. See §8.
NOTIFY_WEBHOOK_URL=http://localhost:3001/webhook/json

# The three below are REQUIRED when NODE_ENV=production; the service
# refuses to start without them (src/config.ts:65-75).
WEBHOOK_HMAC_SECRET=
# Note: the literal value 127.0.0.1 is rejected in production on purpose.
PROXY_IP_WHITELIST=
# Empty = every address allowed. That is a deliberate dev escape hatch
# (D-09); it must be set to the real display machines before going live.
DISPLAY_IP_WHITELIST=

# Phase 6 (ingestion cutover, D-09/D-10). All four have site-independent
# defaults and no production fail-fast — see OPS-RUNBOOK.md §3/§10.
VIEW_PROBE_INTERVAL_MS=60000
STATUS_RATE_LIMIT_WINDOW_MS=60000
STATUS_RATE_LIMIT_MAX=30
STATUS_RATE_LIMIT_MAX_KEYS=10000
