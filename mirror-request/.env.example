PORT=3002
HOST=0.0.0.0

AGENT_WS_TOKEN=replace-with-agent-token
PROXY_IP_WHITELIST=127.0.0.1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=photobooth
DB_USER=extension_service_ro
DB_PASSWORD=replace-with-readonly-password
DB_POLL_INTERVAL_MS=3000
DB_POLL_BATCH_SIZE=50

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM="Photo Booth <no-reply@example.com>"

TWILIO_ACCOUNT_SID=replace-with-twilio-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-token
TWILIO_FROM_NUMBER=+15550000000

SESSION_TIMEOUT_MS=300000
HEARTBEAT_TIMEOUT_MS=30000
NOTIFY_MAX_RETRIES=3
NOTIFY_RETRY_BASE_DELAY_MS=1000

LOCAL_STORE_PATH=./data/extension-service.sqlite

LOG_LEVEL=info
